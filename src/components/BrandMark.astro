---
/**
 * 品牌标记：Q 版「若叶睦抱着黄瓜」。
 * 手绘 SVG，纯路径无外部资源；36px 下保留最有辨识度的三件事：
 * 深色长发 + 半睁的呆眼 + 怀里那根黄瓜。
 */
---

<svg
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- 后发 -->
  <path
    d="M15.5 23c0-9.4 7.4-16 16.5-16s16.5 6.6 16.5 16v23.5c0 4.1-3.2 7.2-7.2 7.2H22.7c-4 0-7.2-3.1-7.2-7.2Z"
    fill="#3a4340"
  />
  <!-- 身体 -->
  <path
    d="M22.5 47.4c0-5.4 4.2-8.6 9.5-8.6s9.5 3.2 9.5 8.6v2.2c0 3-2.2 5.1-5.2 5.1h-8.6c-3 0-5.2-2.1-5.2-5.1Z"
    fill="#2b3341"
  />
  <!-- 黄瓜 -->
  <g transform="rotate(-34 32 46)">
    <rect x="12.6" y="41.7" width="34" height="9" rx="4.5" fill="#4f8f3c" />
    <rect
      x="12.6"
      y="41.7"
      width="34"
      height="9"
      rx="4.5"
      stroke="#35632a"
      stroke-width="1.1"
    />
    <path
      d="M18 43.6h22M18 46.2h22M18 48.8h22"
      stroke="#35632a"
      stroke-width="0.9"
      opacity="0.45"
    />
    <circle cx="46.6" cy="46.2" r="1.9" fill="#35632a" />
  </g>
  <!-- 手 -->
  <circle cx="20.4" cy="48.4" r="3.2" fill="#f7e2d4" />
  <circle cx="42" cy="40.6" r="3.2" fill="#f7e2d4" />
  <!-- 脸 -->
  <circle cx="32" cy="26.4" r="13.2" fill="#fbe8db" />
  <!-- 鬓发（两侧长发，框住脸） -->
  <path
    d="M19.9 21.6c-1.8 4-2.5 8.4-2.1 13 .2 2.5.9 4.4 1.8 5.8.9-.9 1.5-2.2 1.9-4 .6-3.1.3-6.6-1.6-14.8Z"
    fill="#3a4340"
  />
  <path
    d="M44.1 21.6c1.8 4 2.5 8.4 2.1 13-.2 2.5-.9 4.4-1.8 5.8-.9-.9-1.5-2.2-1.9-4-.6-3.1-.3-6.6 1.6-14.8Z"
    fill="#3a4340"
  />
  <!-- 刘海 -->
  <path
    d="M18.9 26c0-8 5.9-13.7 13.1-13.7S45.1 18 45.1 26c-2.6-1-4.1-3.8-5.3-6.4-1.5 3-3.6 5.4-6.6 6.6-1.5-3.2-2.5-5.2-4-6.3-1.3 3.1-3.4 5.3-6.1 6.1-1.4.4-2.8.4-4.2 0Z"
    fill="#3a4340"
  />
  <!-- 眼睛：上眼睑 + 半睁的眼，睦的招牌呆表情 -->
  <g fill="#333033">
    <rect x="25.1" y="28.5" width="4.4" height="1.6" rx="0.8" />
    <rect x="34.5" y="28.5" width="4.4" height="1.6" rx="0.8" />
  </g>
  <g stroke="#333033" stroke-width="1" stroke-linecap="round" opacity="0.9">
    <path d="M24.9 26.8h4.8M34.3 26.8h4.8" />
  </g>
  <!-- 嘴 -->
  <path
    d="M30.9 33h2.2"
    stroke="#c8968c"
    stroke-width="1.2"
    stroke-linecap="round"
  />
</svg>
