---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { href, categories, date } from "../../lib/site";
const posts = (
  await getCollection("posts", (p) => !p.data.draft && !p.data.demo)
).sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate));
const tags = [...new Set(posts.flatMap((p) => p.data.tags))]
  .filter((t) => !categories.includes(t))
  .sort((a, b) => a.localeCompare(b, "zh-CN"));
const searchable = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.description, post.data.category, ...post.data.tags]
    .join(" ")
    .toLowerCase();
const empty = posts.length === 0;
---

<Base title="博客 · 技术手记 — Whalica">
  <div class="shell page compact">
    <h1 class="visually-hidden">技术手记</h1>
    <div class="post-bar">
      <label class="post-search">
        <span class="visually-hidden">搜索文章</span>
        <input
          id="post-filter"
          type="search"
          placeholder={empty ? "还没有文章可搜索" : "搜索标题、摘要或标签"}
          autocomplete="off"
          disabled={empty}
        />
      </label>
      <span class="post-count" id="post-count">
        {empty ? "暂无文章" : `共 ${posts.length} 篇`}
      </span>
      <button
        id="filter-toggle"
        class="filter-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="filter-panel"
        aria-label="筛选与浏览"
        title="筛选与浏览"
        disabled={empty}
      >
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2 2.5h12l-4.6 5.4v5.3l-2.8-1.4V7.9L2 2.5Z" />
        </svg>
        <span class="filter-count" id="filter-count" hidden></span>
      </button>
    </div>
    <div class="filter-panel" id="filter-panel" hidden>
      <div class="filter-group">
        <span class="quiet-label">特殊标签</span>
        <div class="filter-chips filter-chips--special">
          {categories.map((c) => (
            <button
              type="button"
              data-chip={c}
              aria-pressed="false"
              disabled={empty}
            >
              {c}
            </button>
          ))}
        </div>
      </div>
      {tags.length > 0 && (
        <div class="filter-group">
          <span class="quiet-label">标签</span>
          <div class="filter-chips">
            {tags.map((tag) => (
              <button type="button" data-chip={tag} aria-pressed="false">
                {tag}
              </button>
            ))}
          </div>
        </div>
      )}
      <div class="filter-links">
        <a href={href("tags/")}>全部标签 ↗</a>
        <a href={href("archives/")}>归档 ↗</a>
        {Astro.site && <a href={href("rss.xml")}>RSS ↗</a>}
      </div>
    </div>
    {empty ? (
      <div class="empty-state">
        <h2>第一篇手记，正在酝酿。</h2>
        <p>文章会在审阅完成后陆续出现在这里。想先了解这个地方，可以从下面几处开始。</p>
        <div class="empty-links">
          <a class="text-link" href={href("projects/")}>
            做过的项目 →
          </a>
          <a class="text-link" href={href("cp/")}>
            算法与竞赛 →
          </a>
          <a class="text-link" href={href("about/")}>
            关于 Whalica →
          </a>
          {Astro.site && (
            <a class="text-link" href={href("rss.xml")}>
              订阅 RSS →
            </a>
          )}
        </div>
      </div>
    ) : (
      <>
        <div class="post-list" id="post-list">
          {posts.map((p) => (
            <a
              class="post-item"
              href={href("blog/" + p.id + "/")}
              data-tags={[p.data.category, ...p.data.tags].join(" ")}
              data-search={searchable(p)}
            >
              <div class="post-item-head">
                <h2>{p.data.title}</h2>
                <time>{date(p.data.pubDate!)}</time>
              </div>
              <p>{p.data.description}</p>
              <div class="post-item-tags">
                <span class="tag-special">{p.data.category}</span>
                {p.data.tags.map((tag) => (
                  <span>#{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
        <p class="post-none" id="post-none" hidden>
          没有匹配的手记，换个关键词或点掉标签筛选再试试。
        </p>
      </>
    )}
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("#post-filter");
  const list = document.querySelector<HTMLElement>("#post-list");
  const toggle = document.querySelector<HTMLButtonElement>("#filter-toggle");
  const panel = document.querySelector<HTMLElement>("#filter-panel");
  const count = document.querySelector("#post-count");
  const badge = document.querySelector<HTMLElement>("#filter-count");
  const none = document.querySelector<HTMLElement>("#post-none");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    if (panel) panel.hidden = !open;
  });

  if (input && list) {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".post-item"));
    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".filter-chips button"),
    );
    const total = items.length;
    let tag = "";

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const matchQuery =
          !query || (item.dataset.search ?? "").includes(query);
        const matchTag =
          !tag || (item.dataset.tags ?? "").split(" ").includes(tag);
        const visible = matchQuery && matchTag;
        item.hidden = !visible;
        if (visible) shown++;
      }
      if (count) {
        count.textContent =
          shown === total ? `共 ${total} 篇` : `${shown} / ${total} 篇`;
      }
      if (none) none.hidden = shown > 0;
      if (badge) {
        badge.textContent = tag ? "1" : "";
        badge.hidden = !tag;
      }
      for (const chip of chips) {
        chip.setAttribute("aria-pressed", String(chip.dataset.chip === tag));
      }
    };

    input.addEventListener("input", apply);
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        tag = tag === chip.dataset.chip ? "" : chip.dataset.chip!;
        apply();
      });
    }
  }
</script>
