---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { href, categories, date } from "../../lib/site";
const posts = (
  await getCollection("posts", (p) => !p.data.draft && !p.data.demo)
).sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate));
const tags = [...new Set(posts.flatMap((p) => p.data.tags))]
  .filter((t) => !categories.includes(t))
  .sort((a, b) => a.localeCompare(b, "zh-CN"));
const searchable = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.description, post.data.category, ...post.data.tags]
    .join(" ")
    .toLowerCase();
const empty = posts.length === 0;
const topicNotes: Record<string, string> = {
  算法与建模: "推导过程、实现取舍与复杂度分析",
  竞赛复盘: "赛后回看：判断、失误与下一次的修正",
  软件工程: "工程实践、工具选型与踩过的坑",
  学习与研究: "读书笔记与长期积累的东西",
};
---

<Base title="博客 · 技术手记 — Whalica">
  <div class="shell page compact">
    <h1 class="visually-hidden">技术手记</h1>
    <div class="post-bar">
      <label class="post-search">
        <span class="visually-hidden">搜索文章</span>
        <input
          id="post-filter"
          type="search"
          placeholder={empty ? "还没有文章可搜索" : "搜索标题、摘要或标签"}
          autocomplete="off"
          disabled={empty}
        />
      </label>
      <span class="post-count" id="post-count">
        {empty ? "暂无文章" : `共 ${posts.length} 篇`}
      </span>
      <button
        id="select-toggle"
        class="filter-toggle"
        type="button"
        aria-pressed="false"
        aria-label="选择文章下载 Markdown"
        title="选择文章下载 Markdown"
        disabled={empty}
      >
        <svg
          class="icon-pick"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M8 2.6v7.1M5.1 6.9 8 9.8l2.9-2.9M2.9 12.6h10.2" />
        </svg>
        <svg
          class="icon-close"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 4l8 8M12 4l-8 8" />
        </svg>
      </button>
      <button
        id="filter-toggle"
        class="filter-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="filter-panel"
        aria-label="筛选与浏览"
        title="筛选与浏览"
        disabled={empty}
      >
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2 2.5h12l-4.6 5.4v5.3l-2.8-1.4V7.9L2 2.5Z" />
        </svg>
        <span class="filter-count" id="filter-count" hidden></span>
      </button>
    </div>
    <div class="filter-panel" id="filter-panel" hidden>
      <div class="filter-group">
        <span class="quiet-label">分类</span>
        <div class="filter-chips filter-chips--special">
          {categories.map((c) => (
            <button
              type="button"
              data-chip={c}
              aria-pressed="false"
              disabled={empty}
            >
              {c}
            </button>
          ))}
        </div>
      </div>
      {tags.length > 0 && (
        <div class="filter-group">
          <span class="quiet-label">标签</span>
          <div class="filter-chips">
            {tags.map((tag) => (
              <button type="button" data-chip={tag} aria-pressed="false">
                {tag}
              </button>
            ))}
          </div>
        </div>
      )}
      <div class="filter-links">
        <a href={href("tags/")}>全部标签 ↗</a>
        <a href={href("archives/")}>归档 ↗</a>
        {Astro.site && <a href={href("rss.xml")}>RSS ↗</a>}
      </div>
    </div>
    {empty ? (
      <div class="empty-state">
        <h2>第一篇手记，正在酝酿。</h2>
        <p>文章会在审阅完成后陆续出现在这里。想先了解这个地方，可以从下面几处开始。</p>
        <div class="empty-links">
          <a class="text-link" href={href("projects/")}>
            做过的项目 →
          </a>
          <a class="text-link" href={href("cp/")}>
            算法与竞赛 →
          </a>
          <a class="text-link" href={href("about/")}>
            关于 Whalica →
          </a>
          {Astro.site && (
            <a class="text-link" href={href("rss.xml")}>
              订阅 RSS →
            </a>
          )}
        </div>
        <ul class="empty-topics">
          {categories.map((c) => (
            <li>
              <strong>{c}</strong>
              <span>{topicNotes[c]}</span>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <>
        <div class="select-bar" id="select-bar" hidden>
          <button type="button" class="link-button" id="select-all">全选</button>
          <span class="select-count" id="selected-count">已选 0 篇</span>
          <button
            type="button"
            class="batch-download"
            id="download-selected"
            disabled
          >
            打包下载
          </button>
        </div>
        <div class="post-list" id="post-list">
          {posts.map((p) => (
            <div
              class="post-item"
              data-tags={[p.data.category, ...p.data.tags].join(" ")}
              data-search={searchable(p)}
              data-md={href("posts/" + p.id + ".md")}
            >
              <label class="post-select">
                <input type="checkbox" value={p.id} />
                <span class="visually-hidden">选择《{p.data.title}》</span>
              </label>
              <div class="post-item-date">
                <time datetime={p.data.pubDate!.toISOString()}>
                  {date(p.data.pubDate!)}
                </time>
              </div>
              <a class="post-item-link" href={href("blog/" + p.id + "/")}>
                <div class="post-item-head">
                  <h2>{p.data.title}</h2>
                </div>
                <p>{p.data.description}</p>
                <div class="post-item-tags">
                  <span class="tag-special">{p.data.category}</span>
                  {p.data.tags.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </a>
            </div>
          ))}
        </div>
        <p class="post-none" id="post-none" hidden>
          没有匹配的手记，换个关键词或点掉标签筛选再试试。
        </p>
      </>
    )}
  </div>
</Base>

<script>
  import { createZip } from "../../lib/zip";

  const input = document.querySelector<HTMLInputElement>("#post-filter");
  const list = document.querySelector<HTMLElement>("#post-list");
  const toggle = document.querySelector<HTMLButtonElement>("#filter-toggle");
  const panel = document.querySelector<HTMLElement>("#filter-panel");
  const count = document.querySelector("#post-count");
  const badge = document.querySelector<HTMLElement>("#filter-count");
  const none = document.querySelector<HTMLElement>("#post-none");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    if (panel) panel.hidden = !open;
  });

  if (input && list) {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".post-item"));
    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".filter-chips button"),
    );
    const total = items.length;
    let tag = "";

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const matchQuery =
          !query || (item.dataset.search ?? "").includes(query);
        const matchTag =
          !tag || (item.dataset.tags ?? "").split(" ").includes(tag);
        const visible = matchQuery && matchTag;
        item.hidden = !visible;
        if (visible) shown++;
      }
      if (count) {
        count.textContent =
          shown === total ? `共 ${total} 篇` : `${shown} / ${total} 篇`;
      }
      if (none) none.hidden = shown > 0;
      if (badge) {
        badge.textContent = tag ? "1" : "";
        badge.hidden = !tag;
      }
      for (const chip of chips) {
        chip.setAttribute("aria-pressed", String(chip.dataset.chip === tag));
      }
    };

    input.addEventListener("input", apply);
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        tag = tag === chip.dataset.chip ? "" : chip.dataset.chip!;
        apply();
      });
    }
  }

  const selectToggle =
    document.querySelector<HTMLButtonElement>("#select-toggle");
  const selectBar = document.querySelector<HTMLElement>("#select-bar");
  const selectAll = document.querySelector<HTMLButtonElement>("#select-all");
  const downloadBtn = document.querySelector<HTMLButtonElement>(
    "#download-selected",
  );
  const selectedCount = document.querySelector<HTMLElement>("#selected-count");

  if (list && downloadBtn && selectToggle) {
    const rows = Array.from(list.querySelectorAll<HTMLElement>(".post-item"));
    const boxes = rows
      .map((row) => row.querySelector<HTMLInputElement>("input[type=checkbox]"))
      .filter((box): box is HTMLInputElement => box !== null);
    let picking = false;

    const selected = () => boxes.filter((box) => box.checked);

    const sync = () => {
      const picked = selected().length;
      downloadBtn.disabled = picked === 0;
      downloadBtn.textContent = picked > 0 ? `打包下载（${picked}）` : "打包下载";
      if (selectedCount) selectedCount.textContent = `已选 ${picked} 篇`;
      if (!selectAll) return;
      const visible = boxes.filter(
        (box) => !box.closest<HTMLElement>(".post-item")?.hidden,
      );
      const allPicked =
        visible.length > 0 && visible.every((box) => box.checked);
      selectAll.textContent = allPicked ? "取消全选" : "全选";
    };

    const setPicking = (next: boolean) => {
      picking = next;
      document.body.classList.toggle("picking", next);
      selectToggle.setAttribute("aria-pressed", String(next));
      selectToggle.title = next ? "退出选择" : "选择文章下载 Markdown";
      selectToggle.setAttribute("aria-label", selectToggle.title);
      if (selectBar) selectBar.hidden = !next;
      if (!next) for (const box of boxes) box.checked = false;
      sync();
    };

    selectToggle.addEventListener("click", () => setPicking(!picking));

    selectAll?.addEventListener("click", () => {
      const visible = boxes.filter(
        (box) => !box.closest<HTMLElement>(".post-item")?.hidden,
      );
      const allPicked =
        visible.length > 0 && visible.every((box) => box.checked);
      for (const box of visible) box.checked = !allPicked;
      sync();
    });

    for (const box of boxes) box.addEventListener("change", sync);

    // 选择模式下点整行即勾选，不跳转文章
    list.addEventListener("click", (event) => {
      if (!picking) return;
      const row = (event.target as HTMLElement).closest<HTMLElement>(
        ".post-item",
      );
      if (!row) return;
      event.preventDefault();
      const box = row.querySelector<HTMLInputElement>("input[type=checkbox]");
      if (!box) return;
      box.checked = !box.checked;
      sync();
    });

    downloadBtn.addEventListener("click", async () => {
      const pickedRows = selected()
        .map((box) => box.closest<HTMLElement>(".post-item"))
        .filter((row): row is HTMLElement => row !== null);
      if (pickedRows.length === 0) return;

      downloadBtn.disabled = true;
      downloadBtn.classList.add("busy");
      try {
        const encoder = new TextEncoder();
        const entries = await Promise.all(
          pickedRows.map(async (row) => {
            const url = row.dataset.md ?? "";
            const response = await fetch(url);
            if (!response.ok) throw new Error(url);
            return {
              name: decodeURIComponent(url.split("/").pop() ?? "post.md"),
              data: encoder.encode(await response.text()),
            };
          }),
        );
        const blob = new Blob([createZip(entries)], {
          type: "application/zip",
        });
        const href = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = href;
        link.download = "whalica-posts-md.zip";
        document.body.append(link);
        link.click();
        link.remove();
        setTimeout(() => URL.revokeObjectURL(href), 1000);
        setPicking(false);
      } catch {
        downloadBtn.title = "打包失败，请重试";
        setTimeout(() => {
          downloadBtn.title = "";
        }, 2000);
      } finally {
        downloadBtn.classList.remove("busy");
        sync();
      }
    });

    sync();
  }
</script>
