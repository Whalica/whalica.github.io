---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { href, categories, date } from "../../lib/site";
const posts = (
  await getCollection("posts", (p) => !p.data.draft && !p.data.demo)
).sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate));
const searchable = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.description, post.data.category, ...post.data.tags]
    .join(" ")
    .toLowerCase();
---

<Base title="博客 · 技术手记 — Whalica">
  <div class="shell page compact">
    <h1 class="visually-hidden">技术手记</h1>
    <div class="post-tools">
      <label class="post-search">
        <span class="visually-hidden">筛选文章</span>
        <input
          id="post-filter"
          type="search"
          placeholder={posts.length
            ? "筛选：标题、摘要或标签"
            : "还没有文章可筛选"}
          autocomplete="off"
          disabled={posts.length === 0}
        />
      </label>
      <div class="post-links">
        <a href={href("tags/")}>标签 ↗</a>
        <a href={href("archives/")}>归档 ↗</a>
        {Astro.site && <a href={href("rss.xml")}>RSS ↗</a>}
      </div>
    </div>
    <div class="post-filters">
      {categories.map((c) => (
        <button
          type="button"
          data-category={c}
          aria-pressed="false"
          disabled={posts.length === 0}
        >
          {c}
        </button>
      ))}
      <span class="post-result" id="post-count" aria-live="polite">
        {posts.length ? `共 ${posts.length} 篇` : "暂无文章"}
      </span>
    </div>
    {posts.length ? (
      <>
        <div class="post-list" id="post-list">
          {posts.map((p) => (
            <a
              class="post-item"
              href={href("blog/" + p.id + "/")}
              data-category={p.data.category}
              data-search={searchable(p)}
            >
              <div class="post-item-head">
                <span>{p.data.category}</span>
                <time>{date(p.data.pubDate!)}</time>
              </div>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              {p.data.tags.length > 0 && (
                <div class="post-item-tags">
                  {p.data.tags.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
        <p class="post-none" id="post-none" hidden>
          没有匹配的手记，换个关键词或点掉分类筛选再试试。
        </p>
      </>
    ) : (
      <div class="empty-state">
        <h2>第一篇手记，正在酝酿。</h2>
        <p>文章会在审阅完成后陆续出现在这里。想先了解这个地方，可以从下面几处开始。</p>
        <div class="empty-links">
          <a class="text-link" href={href("projects/")}>
            做过的项目 →
          </a>
          <a class="text-link" href={href("cp/")}>
            算法与竞赛 →
          </a>
          <a class="text-link" href={href("about/")}>
            关于 Whalica →
          </a>
          {Astro.site && (
            <a class="text-link" href={href("rss.xml")}>
              订阅 RSS →
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>("#post-filter");
  const list = document.querySelector<HTMLElement>("#post-list");
  if (input && list) {
    const items = Array.from(
      list.querySelectorAll<HTMLElement>(".post-item"),
    );
    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".post-filters button"),
    );
    const count = document.querySelector("#post-count");
    const none = document.querySelector<HTMLElement>("#post-none");
    const total = items.length;
    let category = "";

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const matchQuery =
          !query || (item.dataset.search ?? "").includes(query);
        const matchCategory =
          !category || item.dataset.category === category;
        const visible = matchQuery && matchCategory;
        item.hidden = !visible;
        if (visible) shown++;
      }
      if (count) {
        count.textContent =
          shown === total ? `共 ${total} 篇` : `${shown} / ${total} 篇`;
      }
      if (none) none.hidden = shown > 0;
      for (const chip of chips) {
        chip.setAttribute(
          "aria-pressed",
          String(chip.dataset.category === category),
        );
      }
    };

    input.addEventListener("input", apply);
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        category =
          category === chip.dataset.category ? "" : chip.dataset.category!;
        apply();
      });
    }
  }
</script>
