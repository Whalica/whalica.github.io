---
import Base from "./Base.astro";
import { href, date } from "../lib/site";
import "katex/dist/katex.min.css";
import { getCollection } from "astro:content";
const { post, headings } = Astro.props;
const related = (
  await getCollection(
    "posts",
    (p) =>
      !p.data.draft &&
      !p.data.demo &&
      p.id !== post.id &&
      (p.data.category === post.data.category ||
        p.data.tags.some((tag) => post.data.tags.includes(tag))),
  )
).slice(0, 3);
---

<Base
  title={post.data.title + " · Whalica"}
  description={post.data.description}
  noindex={post.data.demo}
>
  <div class="shell article-shell">
    <a class="back-link" href={href("blog/")}>
      ← 返回技术手记
    </a>
    <header class="article-header">
      <p class="eyebrow">
        {post.data.demo ? "READING PREVIEW / 排版演示" : post.data.category}
      </p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-meta">
        <span>Whalica</span>
        {post.data.pubDate && (
          <time datetime={post.data.pubDate.toISOString()}>
            {date(post.data.pubDate)}
          </time>
        )}
        {post.data.updatedDate ? (
          <time datetime={post.data.updatedDate.toISOString()}>
            更新于 {date(post.data.updatedDate)}
          </time>
        ) : (
          <span>{post.data.demo ? "演示 · 无发布日期" : "首次发布"}</span>
        )}
      </div>
      <div class="tags">
        {post.data.tags.map((tag: string) =>
          post.data.demo ? (
            <span>{tag}</span>
          ) : (
            <a href={href("tags/") + "#" + encodeURIComponent(tag)}>{tag}</a>
          ),
        )}
      </div>
    </header>
    <div class="article-grid">
      <article
        class="prose"
        data-pagefind-body={!post.data.demo ? true : undefined}
      >
        <slot />
      </article>
      <aside class="article-sidebar">
        <details open>
          <summary>
            本文目录 <span>↕</span>
          </summary>
          <nav aria-label="文章目录">
            {headings
              .filter((h: { depth: number }) => h.depth === 2 || h.depth === 3)
              .map((h: { depth: number; slug: string; text: string }) => (
                <a class={h.depth === 3 ? "toc-sub" : ""} href={"#" + h.slug}>
                  {h.text}
                </a>
              ))}
          </nav>
        </details>
        <p>
          把问题想清楚，
          <br />
          把过程记录下来。
        </p>
      </aside>
    </div>
    {related.length > 0 && (
      <section class="related-articles">
        <h2>相关阅读</h2>
        {related.map((p) => (
          <p>
            <a href={href("blog/" + p.id + "/")}>{p.data.title} →</a>
          </p>
        ))}
      </section>
    )}
    <div class="article-end">
      <span>— 本文结束 —</span>
      <a class="text-link" href={href("blog/")}>
        继续探索技术手记 →
      </a>
    </div>
  </div>
  <script>
    document.querySelectorAll("pre").forEach((pre) => {
      const button = document.createElement("button");
      button.className = "copy-button";
      button.textContent = "复制代码";
      button.setAttribute("aria-label", "复制代码");
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(
            pre.querySelector("code")?.textContent || "",
          );
          button.textContent = "已复制";
        } catch {
          button.textContent = "复制失败，请手动选择";
        }
        setTimeout(() => (button.textContent = "复制代码"), 2000);
      });
      const wrap = document.createElement("div");
      wrap.className = "code-wrap";
      pre.before(wrap);
      wrap.append(button, pre);
    });
    const details = document.querySelector<HTMLDetailsElement>(
      ".article-sidebar details",
    );
    if (details && matchMedia("(max-width: 1023px)").matches)
      details.open = false;
  </script>
</Base>
